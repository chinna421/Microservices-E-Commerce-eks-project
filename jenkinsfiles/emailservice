pipeline {
    agent any

    environment {
        AWS_REGION = 'us-east-1'
        AWS_ACCOUNT_ID = '725224325250'
        ECR_REGISTRY = "${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com"
        IMAGE_NAME = 'emailservice'
        ECR_REPOSITORY = "${ECR_REGISTRY}/${IMAGE_NAME}"

        GIT_REPO_NAME = 'Microservices-E-Commerce-eks-project'
        GIT_USER_NAME = 'chinna421'
        GIT_EMAIL = 'rajashekar9576@gmail.com'
        YAML_FILE = 'emailservice.yaml'
    }

    stages {

        stage('Cleaning Workspace') {
            steps {
                cleanWs()
            }
        }

        stage('Checkout from Git') {
            steps {
                git branch: 'master',
                    url: 'https://github.com/chinna421/Microservices-E-Commerce-eks-project.git'
            }
        }

        stage('Docker Image Build') {
            steps {
                dir('src/emailservice') {
                    sh '''
                        echo "Building Docker image..."
                        docker build -t ${IMAGE_NAME}:${BUILD_NUMBER} .
                        docker tag ${IMAGE_NAME}:${BUILD_NUMBER} ${IMAGE_NAME}:latest
                    '''
                }
            }
        }

        stage('ECR Image Pushing') {
            steps {
                sh '''
                    echo "Logging in to Amazon ECR..."

                    aws ecr get-login-password \
                        --region ${AWS_REGION} | \
                    docker login \
                        --username AWS \
                        --password-stdin ${ECR_REGISTRY}

                    echo "Tagging image..."

                    docker tag \
                        ${IMAGE_NAME}:${BUILD_NUMBER} \
                        ${ECR_REPOSITORY}:${BUILD_NUMBER}

                    echo "Pushing image..."

                    docker push \
                        ${ECR_REPOSITORY}:${BUILD_NUMBER}

                    echo "Image pushed successfully:"
                    echo "${ECR_REPOSITORY}:${BUILD_NUMBER}"
                '''
            }
        }

        stage('Update Deployment File') {
            steps {
                dir('kubernetes-files') {

                    withCredentials([
                        string(
                            credentialsId: 'my-git-pattoken',
                            variable: 'GIT_TOKEN'
                        )
                    ]) {

                        sh '''
                            set -e

                            echo "Updating Kubernetes deployment..."

                            git config user.email "${GIT_EMAIL}"
                            git config user.name "${GIT_USER_NAME}"

                            sed -i \
                                "s#image:.*#image: ${ECR_REPOSITORY}:${BUILD_NUMBER}#g" \
                                ${YAML_FILE}

                            echo "Updated image:"
                            grep "image:" ${YAML_FILE}

                            git add ${YAML_FILE}

                            git commit \
                                -m "Update ${IMAGE_NAME} image to version ${BUILD_NUMBER}" \
                                || echo "No changes to commit"

                            git push \
                                https://${GIT_TOKEN}@github.com/${GIT_USER_NAME}/${GIT_REPO_NAME}.git \
                                HEAD:master
                        '''
                    }
                }
            }
        }
    }

    post {
        success {
            echo '======================================'
            echo 'Pipeline completed successfully!'
            echo "Image: ${ECR_REPOSITORY}:${BUILD_NUMBER}"
            echo '======================================'
        }

        failure {
            echo '======================================'
            echo 'Pipeline FAILED'
            echo 'Check the stage logs for details.'
            echo '======================================'
        }

        always {
            echo 'Cleaning temporary Docker resources...'

            sh '''
                docker container prune -f || true
            '''
        }
    }
}
